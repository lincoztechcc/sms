// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// SAAS MULTI-TENANT & CORE MODULES
// ==========================================

model School {
  id                 String   @id @default(cuid())
  name               String
  domain             String?  @unique
  plan               String   @default("TRIAL") // 6_MONTHS, YEARLY, LIFETIME
  subscriptionStatus String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  licenseKey         String?  @unique
  licenseExpiry      DateTime?
  logo               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations - All data scoped to a school
  users       User[]
  students    Student[]
  teachers    Teacher[]
  classes     Class[]
  sections    Section[]
  subjects    Subject[]
  attendances Attendance[]
  fees        Fee[]
  expenses    Expense[]
  exams       Exam[]
  results     Result[]
  routes      Route[]
  books       Book[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("ADMIN") // SUPERADMIN, ADMIN, PRINCIPAL, TEACHER, STUDENT
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
}

model Student {
  id          String   @id @default(cuid())
  studentId   String   @unique
  name        String
  grade       String
  section     String
  rollNo      String
  parentName  String
  phone       String
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])

  // Relations
  attendances Attendance[]
  results     Result[]
  fees        Fee[]
}

model Teacher {
  id            String   @id @default(cuid())
  teacherId     String   @unique
  name          String
  email         String   @unique
  phone         String
  qualification String
  department    String
  salary        Float
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Multi-tenant
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])

  // Relations
  classes       Class[]
  subjects      Subject[]
  attendances   Attendance[]
}

// ==========================================
// ACADEMICS MODULE
// ==========================================

model Class {
  id        String   @id @default(cuid())
  name      String   // e.g. "10th"
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  // Relations
  sections  Section[]
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
}

model Section {
  id        String   @id @default(cuid())
  name      String   // e.g. "A"
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  // Relations
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
}

// ==========================================
// ATTENDANCE MODULE
// ==========================================

model Attendance {
  id        String   @id @default(cuid())
  date      DateTime
  status    String   // Present, Absent, Late
  type      String   // STUDENT, TEACHER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  // Optional relations depending on type
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
}

// ==========================================
// FINANCE & FEE MODULE
// ==========================================

model Fee {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  amount      Float
  status      String   // Paid, Unpaid, Partial
  dueDate     DateTime
  paidDate    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  date        DateTime
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
}

// ==========================================
// EXAM MODULE
// ==========================================

model Exam {
  id        String   @id @default(cuid())
  name      String   // e.g. "Mid Term"
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  // Relations
  results   Result[]
}

model Result {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id])
  marks     Float
  total     Float
  grade     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
}

// ==========================================
// TRANSPORT MODULE
// ==========================================

model Route {
  id          String   @id @default(cuid())
  name        String
  vehicleNo   String
  driverName  String
  driverPhone String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
}

// ==========================================
// LIBRARY MODULE
// ==========================================

model Book {
  id        String   @id @default(cuid())
  title     String
  author    String
  isbn      String   @unique
  quantity  Int
  available Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
}
